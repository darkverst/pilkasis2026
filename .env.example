# 1. DATABASE CONNECTION
# Untuk Development Lokal (SQLite):
DATABASE_URL="file:./db/custom.db"

# Untuk Production (Vercel / Cloud via PostgreSQL - Supabase / Neon / Vercel Postgres / Aiven):
# DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# 2. ADMIN CREDENTIALS & SECURITY
# Password untuk login ke Panel Panitia / Admin (/admin)
ADMIN_PASSWORD="MGMPINFBWI"

# Kunci rahasia untuk enkripsi/tanda tangan HMAC-SHA256 cookie sesi admin (minimal 32 karakter acak)
ADMIN_SESSION_SECRET="ubah_dengan_string_acak_rahasia_dan_panjang_demi_keamanan_sesi_admin_2026"

# 3. REALTIME WEBSOCKET (Opsional - default menggunakan polling reaktif)
# NEXT_PUBLIC_SOCKET_URL=""
# SOCKET_SERVICE_URL=""
