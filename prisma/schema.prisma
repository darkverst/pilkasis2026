// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local dev uses SQLite. Production uses PostgreSQL (see schema.prod.prisma).
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// School election settings (single row, id = "default")
model Settings {
  id                 String   @id @default("default")
  schoolName         String   @default("SMP Negeri 1 Nusantara")
  schoolLogo         String   @default("") // data URL or path
  electionTitle      String   @default("Pemilihan Ketua & Wakil OSIS 2025")
  electionDescription String  @default("Pilih pemimpin OSIS pilihanmu untuk periode 2025/2026.")
  isActive           Boolean  @default(true)
  startTime          DateTime?
  endTime            DateTime?
  totalVoters        Int      @default(0)
  resultsPublic      Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

// Election candidates
model Candidate {
  id        String   @id @default(cuid())
  name      String
  class     String   // kelas, e.g. "IX A"
  photo     String   @default("")
  vision    String
  mission   String
  order     Int      @default(0)
  color     String   @default("#3b82f6")
  isPair        Boolean  @default(false)
  partnerName   String   @default("")
  partnerClass  String   @default("")
  partnerPhoto  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  votes     Vote[]
}

// One-time-use voting tokens issued by admin/panitia
model Voter {
  id        String    @id @default(cuid())
  token     String    @unique
  role      String    @default("student")
  name      String?
  hasVoted  Boolean   @default(false)
  votedAt   DateTime?
  usedToken Boolean   @default(false)
  batch     String?
  createdAt DateTime  @default(now())
  vote      Vote?
}

// A cast vote (one per voter)
model Vote {
  id          String   @id @default(cuid())
  candidateId String
  voterId     String   @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  voter       Voter     @relation(fields: [voterId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}
